# Required
OPENAI_API_KEY=sk-...
# Long random string. It is part of the connector URL, so treat it like a password.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_SECRET=
# Public HTTPS origin the server is reachable at (no trailing slash).
PUBLIC_BASE_URL=https://chronos-images.example.com

# Optional
PORT=8787
DATA_DIR=./data
# "reference" tier: closely follows approved reference images.
IMAGE_MODEL_REFERENCE=gpt-image-2.5-sunburst
# "draft" tier: faster, cheaper exploration.
IMAGE_MODEL_DRAFT=gpt-image-2.5-flare
OPENAI_BASE_URL=https://api.openai.com/v1
