{
  "name": "chronos-learning",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/content/validate.ts",
    "lesson:preview": "tsx scripts/lesson/preview.ts",
    "lesson:gate": "tsx scripts/lesson/gate.ts",
    "lesson:prepare-publication": "tsx scripts/lesson/prepare-publication.ts",
    "media:add": "tsx scripts/media/add.ts",
    "media:build": "tsx scripts/media/build.ts",
    "media:verify": "tsx scripts/media/build.ts --check",
    "media:ingest-sources": "npm run media:verify && tsx scripts/media/publish.ts --sources-only",
    "media:publish": "tsx scripts/media/publish.ts",
    "media:verify:remote": "tsx scripts/media/publish.ts --verify-only",
    "test:domain": "vitest run tests/domain tests/content tests/legacy tests/lesson",
    "test:hero-delivery": "node scripts/verify-hero-delivery.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "@supabase/supabase-js": "^2.47.0",
    "@tanstack/react-query": "^5.90.19",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "sharp": "0.35.3",
    "tsx": "^4.20.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
